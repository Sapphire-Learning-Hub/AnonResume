  "name": "anonresume",
  "version": "1.8.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bun run scripts/diagnostics/build.ts",
    "diagnostics:symbolicate": "bun run scripts/diagnostics/symbolicate.ts",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run check:static && bun run test",
    "check:static": "bun run lint && bun run check:styles && next typegen && bunx tsc --noEmit",
    "check:styles": "bun run scripts/check-style-architecture.ts",
    "metrics:up": "docker compose -f compose.metrics.yaml up -d --wait",
    "metrics:down": "docker compose -f compose.metrics.yaml down",
    "metrics:smoke": "bun run scripts/observability/metrics-smoke.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "config:import-env": "bun run scripts/config-import-env.ts",
    "config:doctor": "bun run scripts/config-doctor.ts",
    "config:reencrypt-secrets": "bun run scripts/config-reencrypt-secrets.ts",
    "worker:ai": "bun run scripts/ai-worker.ts",
    "worker:pdf": "bun run scripts/pdf-worker.ts",
    "ai:maintenance": "bun run scripts/ai-maintenance.ts",
    "account:maintenance": "bun run scripts/account-maintenance.ts",
    "auth:migrate": "bun run scripts/auth-migrate.ts",
    "deploy:migrate": "bun run auth:migrate -- --yes && bun run db:migrate",
    "deploy:bootstrap-admin": "bun run scripts/bootstrap-admin-link.ts",
    "deploy:setup-deactivate": "bun run scripts/setup-deactivate.ts",
    "deploy:healthcheck": "bun run scripts/healthcheck.ts",
    "admin:doctor": "bun run scripts/admin-doctor.ts",
    "admin:bootstrap": "bun run scripts/admin-bootstrap.ts",
    "admin:repair-super-admin": "bun run scripts/admin-repair-super-admin.ts",
    "admin:reset-mfa": "bun run scripts/admin-reset-mfa.ts"
  },
