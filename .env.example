# Every uncommented value in this file is required in production. Missing or
# invalid production configuration places the whole instance in read-only
# maintenance mode and returns HTTP 503 for operations.

# PostgreSQL connection used by Better Auth and resume persistence.
DATABASE_URL=postgresql://app_user:change_me@127.0.0.1:5432/anonresume

# Public origin for authentication callbacks and generated links. Use HTTPS in production.
BETTER_AUTH_URL=https://resume.example.com

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace_with_a_64_character_random_secret

# Email verification. Port 587 uses STARTTLS; port 465 uses implicit TLS.
# Development uses SMTP whenever these values are complete. Without SMTP,
# development prints verification links to the server console instead.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASSWORD=replace_with_smtp_password
EMAIL_FROM=AnonResume <mailer@example.com>
EMAIL_VERIFICATION_EXPIRES_SECONDS=3600

# Optional public source repository shown in Settings > About.
NEXT_PUBLIC_SOURCE_CODE_URL=https://github.com/Sapphire-Learning-Hub/AnonResume

# Optional: isolate AnonResume tables in a PostgreSQL schema.
# ANONRESUME_DB_SCHEMA=anonresume

# PDF queue capacity shared by every worker through PostgreSQL. Production
# requires explicit values so a typo cannot silently fall back to another limit.
PDF_EXPORT_MAX_CONCURRENCY=2
PDF_EXPORT_QUEUE_LIMIT=100
# Maximum queued or running exports owned by one authenticated user.
PDF_EXPORT_MAX_ACTIVE_PER_USER=3
PDF_EXPORT_MAX_ATTEMPTS=3
PDF_EXPORT_LEASE_MS=60000
PDF_EXPORT_RESULT_TTL_MS=900000
# Hard lifetime for every export job, including queued and running jobs.
PDF_EXPORT_FORCE_EXPIRY_MS=86400000
# Anonymous export is disabled by default. Enabling it is not recommended because
# unauthenticated callers can consume shared queue and browser capacity.
PDF_EXPORT_ALLOW_ANONYMOUS=false

# Maximum number of snapshots retained for each resume.
RESUME_VERSION_HISTORY_LIMIT=5

# Management console bootstrap and second-factor isolation. The first production
# startup creates a pending super-admin identity for this email when none exists.
ANONRESUME_SUPER_ADMIN_EMAIL=owner@example.com
# Generate with: openssl rand -base64 32
ADMIN_MFA_ENCRYPTION_KEY=replace_with_a_base64_encoded_32_byte_key
ADMIN_SESSION_IDLE_SECONDS=1800
ADMIN_SESSION_MAX_SECONDS=28800
ADMIN_REAUTH_SECONDS=300

# AI editing assistant. Keep disabled until at least one platform model or
# user-provided compatible provider has been configured.
AI_ENABLED=false
AI_PLATFORM_ENABLED=false
AI_BYOK_ENABLED=false
# Generate with: openssl rand -base64 32
AI_CREDENTIALS_ENCRYPTION_KEY=replace_with_a_base64_encoded_32_byte_key
# Exact HTTPS provider hostnames allowed to resolve through 198.18.0.0/15 proxy Fake-IP mode.
AI_TRUSTED_ENDPOINT_HOSTNAMES=
# Encrypted request/response evidence retention for billing investigations.
AI_AUDIT_RETENTION_DAYS=30
AI_STREAM_CHECKPOINT_MS=1000
AI_RUN_LEASE_SECONDS=90
AI_REQUESTS_PER_MINUTE=10
AI_MAX_CONCURRENT_RUNS=1
AI_DEFAULT_MONTHLY_POINTS=100000
# The dedicated AI worker executes queued requests, recovers expired runs, and
# removes expired audit evidence. These optional values use the shown defaults.
AI_WORKER_BATCH_SIZE=100
AI_WORKER_POLL_INTERVAL_MS=5000
AI_WORKER_RECOVERY_INTERVAL_MS=15000
AI_WORKER_RETENTION_INTERVAL_MS=3600000

# Optional GitHub OAuth sign-in.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
