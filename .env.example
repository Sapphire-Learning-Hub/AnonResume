# AnonResume only reads these deployment trust roots at runtime. In production,
# provide them through systemd Credentials instead of a repository-local file.

# PostgreSQL connection used by the application, workers, and migrations.
DATABASE_URL=postgresql://app_user:change_me@127.0.0.1:5432/anonresume

# Public origin for authentication callbacks and generated links.
# Production requires HTTPS.
BETTER_AUTH_URL=https://resume.example.com

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace_with_a_64_character_random_secret

# Generate with: openssl rand -base64 32
CONFIG_MASTER_KEY=replace_with_a_base64_encoded_32_byte_key

# Container and secret-manager deployments may provide any bootstrap value
# through a file instead. Remove the corresponding direct value above when
# enabling one of these variables; configuring both sources is rejected.
# DATABASE_URL_FILE=/run/secrets/database-url
# BETTER_AUTH_URL_FILE=/run/secrets/application-origin
# BETTER_AUTH_SECRET_FILE=/run/secrets/auth-secret
# CONFIG_MASTER_KEY_FILE=/run/secrets/config-master-key

# Optional: isolate AnonResume tables in a PostgreSQL schema.
# ANONRESUME_DB_SCHEMA=anonresume

# Optional structured logging controls. Production defaults to JSON/info;
# development defaults to pretty/debug output. Keep JSON when a collector
# parses stdout, and drop every event where labels.centralize is false before
# forwarding or persistence. See docs/operations/observability.md.
# ANONRESUME_LOG_LEVEL=info
# ANONRESUME_LOG_FORMAT=json
# ANONRESUME_LOG_ENVIRONMENT=production

# Optional one-time OpenTelemetry metrics import. Runtime values are managed in
# the platform configuration center after import; these variables do not
# override an active revision. Enabling requires a signal-specific endpoint
# ending in /v1/metrics. Prefer HTTPS outside private local networks.
# OTEL_METRICS_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://collector.example.com/v1/metrics
# OTEL_EXPORTER_OTLP_METRICS_HEADERS=authorization=Bearer replace_me
# OTEL_METRIC_EXPORT_INTERVAL=60000
# OTEL_EXPORTER_OTLP_METRICS_TIMEOUT=10000

# Optional during CONFIG_MASTER_KEY rotation. Remove only after all encrypted
# values have been re-encrypted and verified with the current master key.
# CONFIG_MASTER_KEY_PREVIOUS=replace_with_the_previous_base64_encoded_key

# Deprecated one-release compatibility input for `bun run admin:bootstrap`.
# New installations read the Web startup code and finish at /setup instead.
# ANONRESUME_SUPER_ADMIN_EMAIL=owner@example.com

# Migration-only compatibility keys for an existing installation. Keep these
# only for the compatibility window, run `bun run config:reencrypt-secrets`,
# verify the result, and remove them in a later deployment.
# ADMIN_MFA_ENCRYPTION_KEY=replace_with_the_legacy_base64_encoded_32_byte_key
# AI_CREDENTIALS_ENCRYPTION_KEY=replace_with_the_legacy_base64_encoded_32_byte_key

# Runtime settings such as SMTP, OAuth, PDF queue limits, resume retention, AI
# switches, quotas, and worker cadence are maintained in the management console.
# Existing deployments can import their legacy variables once with
# `bun run config:import-env --dry-run` followed by `--apply`.

# Optional one-time import values for legal and support settings. Prefer
# maintaining these fields in the management console after initialization.
# LEGAL_OPERATOR_NAME=Example Organization
# LEGAL_CONTACT_EMAIL=support@example.com
# LEGAL_EFFECTIVE_DATE=2026-10-09
# PRIVACY_POLICY_URL=https://resume.example.com/privacy
# TERMS_OF_SERVICE_URL=https://resume.example.com/terms
# SUPPORT_URL=https://support.example.com
