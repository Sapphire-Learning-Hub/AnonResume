# Required: use a published immutable release tag, never "latest".
ANONRESUME_VERSION=vX.Y.Z

# Required: public HTTPS origin used for authentication callbacks and links.
BETTER_AUTH_URL=https://resume.example.com

# First startup: read the one-time code from Web logs and finish at /setup.
# SMTP is not required for this setup flow. Do not store the code in this file.

# Optional deployment identity and host port.
ANONRESUME_DEPLOYMENT_ID=production
ANONRESUME_PORT=3000

# Optional structured logging controls. Keep JSON for centralized collection.
# Local-only sensitive events carry labels.centralize=false and must be dropped.
# ANONRESUME_LOG_LEVEL=info
# ANONRESUME_LOG_FORMAT=json
# ANONRESUME_LOG_ENVIRONMENT=production

# Optional local metrics stack host ports. Metrics are enabled and configured
# from the platform configuration center, not from this Compose environment.
# OTEL_HTTP_PORT=4318
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3001
# GRAFANA_ADMIN_PASSWORD=replace_with_a_local_only_password

# Optional image overrides for private registries and supported PostgreSQL tags.
# ANONRESUME_IMAGE=ghcr.io/sapphire-learning-hub/anonresume
# ANONRESUME_PDF_IMAGE=ghcr.io/sapphire-learning-hub/anonresume-pdf
# POSTGRES_IMAGE=postgres:17-alpine

# Optional PostgreSQL database and role names. Passwords are generated internally.
# These values initialize the persistent volumes and must not be changed later.
# POSTGRES_DB=anonresume
# POSTGRES_USER=anonresume
